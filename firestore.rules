rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function setupPath() { return /databases/$(database)/documents/config/setup; }
    function small(max) { return request.resource.data.size() <= max; }

    // Public site content: everyone reads, only admins write.
    match /site/{doc}      { allow read: if true; allow write: if isAdmin(); }
    match /events/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /notices/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{id}    { allow read: if true; allow write: if isAdmin(); }

    // Visitor submissions: anyone may create (bounded), only admins read / delete.
    match /registrations/{id} { allow create: if small(14); allow read, update, delete: if isAdmin(); }
    match /prayers/{id}       { allow create: if small(10); allow read, update, delete: if isAdmin(); }
    match /messages/{id}      { allow create: if small(10); allow read, update, delete: if isAdmin(); }
    match /subscribers/{id}   { allow create: if small(4);  allow read, delete: if isAdmin(); }
    match /visits/{id}        { allow create: if small(6);  allow read, delete: if isAdmin(); }

    // Admins. First run: no config/setup yet -> the first account claims it in one batch.
    // Later: only while an admin has opened setup, and only with the current setup code.
    match /admins/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid && (
        (!exists(setupPath()) && existsAfter(setupPath())) ||
        (exists(setupPath()) && get(setupPath()).data.open == true && request.resource.data.code == get(setupPath()).data.code)
      );
      allow update, delete: if isAdmin();
    }
    match /config/setup {
      allow read, update, delete: if isAdmin();
      allow create: if signedIn() && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Public flag the setup page reads to know whether it is open.
    match /config/status {
      allow read: if true;
      allow create: if signedIn() && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid)) && !exists(/databases/$(database)/documents/config/status);
      allow update, delete: if isAdmin();
    }
  }
}
